from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import pandas as pd
import time

# WebDriver initialization
driver = webdriver.Chrome()

# Zigzag search URL
url = "https://zigzag.kr/search?keyword=파자마"
driver.get(url)

# Wait for the first product to load (updated selector)
WebDriverWait(driver, 10).until(
    EC.presence_of_element_located((By.CSS_SELECTOR, ".css-5hci9z"))
)

# Initialize data collection
data = []
scroll_attempts = 0
max_scroll_attempts = 10

while len(data) < 30 and scroll_attempts < max_scroll_attempts:
    # Collect product information
    items = driver.find_elements(By.CSS_SELECTOR, ".css-5hci9z")
    
    for item in items:
        if len(data) >= 30:
            break
        try:
            # Updated selectors
            brand = item.find_element(By.CSS_SELECTOR, "zds4_1kdomr8").text
            name = item.find_element(By.CSS_SELECTOR, ".span.zds4_1kdomrc").text
            price = item.find_element(By.CSS_SELECTOR, ".span.zds4_s96ru86").text
            link = item.find_element(By.CSS_SELECTOR, ".a.product-card-link").get_attribute('href')
            
            # Only append if we haven't already collected this item
            product_data = {
                "brand": brand,
                "name": name,
                "price": price,
                "link": link
            }
            
            if product_data not in data:
                data.append(product_data)
                print(f"Collected {len(data)} products")
                
        except Exception as e:
            print(f"Error collecting item data: {e}")
            continue

    # Scroll down
    driver.execute_script("window.scrollBy(0, document.body.scrollHeight);")
    time.sleep(3)  # Increased wait time for better reliability
    scroll_attempts += 1
    print(f"Scroll attempt {scroll_attempts}/{max_scroll_attempts}")

# Convert to DataFrame and save
df = pd.DataFrame(data)
print("\nFinal collection summary:")
print(f"Total products fetched: {len(data)}")
print(df)

# Save to CSV
df.to_csv("zigzag_pajamas.csv", index=False, encoding="utf-8-sig")

driver.quit()

# WebDriver 초기화
driver = webdriver.Chrome()

# GSSHOP URL
url = "https://www.gsshop.com/shop/search/main.gs?tq=%EC%9E%A0%EC%98%B7&rq=&applyTypoProcess=true&cls=&eh=eyJzb3J0VHlwZSI6IlJFVklFV19DT1VOVCIsInNlbGVjdGVkIjoib3B0LXNvcnQifQ%3D%3D"
driver.get(url)

time.sleep(2)  # 페이지 로딩 대기

# 스크롤을 내리며 모든 상품 로딩
data = []
last_height = driver.execute_script("return document.body.scrollHeight")

while len(data) < 30:  # 수집된 데이터가 30개 미만일 때 반복
    driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
    time.sleep(2)  # 스크롤 후 로딩 대기
    new_height = driver.execute_script("return document.body.scrollHeight")
    if new_height == last_height:  # 더 이상 로딩되는 내용이 없으면 중지
        break
    last_height = new_height

    # 스크롤 후 상품 정보 수집
    items = driver.find_elements(By.CSS_SELECTOR, '.prd-list .prd-item')
    for item in items:
        if len(data) >= 30:  # 30개 이상이면 중단
            break
        try:
            name = item.find_element(By.CSS_SELECTOR, '.prd-name').text
            price = item.find_element(By.CSS_SELECTOR, '.set-price').text
            link = item.find_element(By.TAG_NAME, 'a').get_attribute('href')
            
            data.append({
                "name": name,
                "price": price,
                "link": link,
            })
        except Exception as e:
            print(f"Error: {e}")
            continue

# 데이터프레임으로 변환 후 저장
df = pd.DataFrame(data)
print(f"Total products fetched: {len(data)}")
print(df)

# CSV 파일로 저장
df.to_csv("gsshop_pajamas.csv", index=False, encoding="utf-8-sig")

driver.quit()

