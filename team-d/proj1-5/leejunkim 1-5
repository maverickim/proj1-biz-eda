import re
import pandas as pd

def del_special_letter(s):
    """특수 문자 제거 함수"""
    return re.sub(r"[^\uAC00-\uD7A3 0-9a-zA-Z\s]", "", s)

def handle_space(s_list):
    """공백 제거 및 빈 문자열 처리 함수"""
    s_list = [s.strip() for s in s_list]  # 양쪽 공백 제거
    return [s for s in s_list if s]  # 빈 문자열 제거

# 파일 경로
file_path = r"C:\python\29cm_reviews.csv"

# 1. CSV 파일 읽기
df = pd.read_csv(file_path, encoding='utf-8')

# 2. '리뷰내용' 컬럼에 대해 특수 문자 제거 및 공백 처리
df['리뷰내용_불용어처리'] = df['리뷰내용'].apply(lambda x: ' '.join(handle_space(del_special_letter(str(x)).split())))

# 3. 결과 CSV 파일로 저장
output_path = r"C:\python\fastcampus\cleaned_reviews.csv"
df.to_csv(output_path, index=False, encoding='utf-8-sig')

